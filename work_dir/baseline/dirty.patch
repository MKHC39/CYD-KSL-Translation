+    @staticmethod
+    def masked_mean_pool_time_major(seq: torch.Tensor, lens: torch.Tensor) -> torch.Tensor:
+        """
+        seq: (T, B, D)
+        lens: (B,) valid lengths
+        returns: (B, D)
+        """
+        # TemporalConv returns lens on CPU; move to seq device for masking
+        lens = lens.to(device=seq.device)
+
+        T, B, D = seq.shape
+        t = torch.arange(T, device=seq.device).unsqueeze(1)  # (T,1)
+        mask = (t < lens.unsqueeze(0)).unsqueeze(-1)  # (T,B,1) boolean
+
+        seq = seq.masked_fill(~mask, 0.0)
+        denom = lens.clamp(min=1).unsqueeze(1).to(seq.dtype)  # (B,1)
+        return seq.sum(dim=0) / denom  # (B,D)
+
